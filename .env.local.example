# Optional local overrides for Docker Compose.
# The default compose.local.yaml is self-contained for local smoke testing.

COMPOSE_PROJECT_NAME=bifrost-local
BIFROST_ROOT_VERSE=asgard
BIFROST_MACHINE_ID=yggdrasil

# Epiphany operator admission. Endpoint and trust anchor are explicit; there is
# no localhost or identity-string fallback.
BIFROST_EPIPHANY_OPERATOR_REQUEST_STORE=.bifrost/epiphany-operator-requests.cc
BIFROST_EPIPHANY_OPERATOR_LEDGER_STORE=.bifrost/epiphany-operator-ledger.cc
BIFROST_EPIPHANY_OPERATOR_DISCORD_DELIVERY_STORE=.bifrost/epiphany-operator-discord-deliveries.cc
BIFROST_EPIPHANY_OPERATOR_PRIVATE_KEY=.bifrost/private/epiphany-operator-ed25519.seed
BIFROST_EPIPHANY_OPERATOR_RUDP=rudp://yggdrasil:49100
BIFROST_EPIPHANY_EXECUTOR_TRUST_ANCHOR=.bifrost/trust/epiphany-operator-executor.cc
BIFROST_EPIPHANY_OPERATOR_OWNER_DISCORD_ID=
BIFROST_EPIPHANY_OPERATOR_TARGET_RUNTIME_ID=epiphany-yggdrasil
BIFROST_PERSONA_FEEDBACK_PRIVATE_STORE=.bifrost/persona-feedback-private.cc
BIFROST_EPIPHANY_OPERATOR_CULTMESH_URI=
