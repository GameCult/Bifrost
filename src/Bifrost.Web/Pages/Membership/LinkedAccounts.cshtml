@page
@model Bifrost.Web.Pages.Membership.LinkedAccountsModel
@{
    ViewData["Title"] = "Linked accounts";
}

<section class="panel">
    <span class="eyebrow">Heimdall</span>
    <h1>Linked accounts</h1>
    <p class="panel-intro">
        The provider logins that sign in to this account. Heimdall holds them and decides what may change; Bifrost keeps none of
        your Heimdall sign-in, so each action sends you through Heimdall once more.
    </p>

    @if (Model.ResultMessage is not null)
    {
        <div class="callout" role="status">@Model.ResultMessage</div>
    }

    @if (!Model.HasHeimdallAccount)
    {
        <div class="callout warning">
            This session is not a Heimdall account, so there are no provider logins to manage here. Sign in with Discord or Patreon
            through Heimdall to see them.
        </div>
    }
    else
    {
        <h2>Your logins</h2>
        @if (Model.Identities is null)
        {
            <p class="muted">
                Bifrost does not hold the list: it asks Heimdall, which means signing in to Heimdall again, and keeps the answer for
                five minutes. It also cannot tell which logins this account holds right now, so it will not choose one for you.
                Pick a login you know it holds. Signing in through Discord or Patreon when the account no longer holds that login
                would create a separate Heimdall account holding it. Google cannot do that: Heimdall refuses a Google sign-in for a
                login no account holds.
            </p>
            <div class="panel-actions">
                @foreach (var provider in Model.LinkableProviders.OrderBy(x => x == "google" ? 0 : 1))
                {
                    <form method="post" asp-page-handler="Refresh" class="inline-actions">
                        <input type="hidden" name="via" value="@provider" />
                        <button class="button secondary" type="submit">Show my logins through @LinkedAccountsModel.ProviderName(provider)@(provider == "google" ? " (cannot create an account)" : "")</button>
                    </form>
                }
            </div>
        }
        else
        {
            <ul>
                @foreach (var identity in Model.Identities)
                {
                    <li>
                        <strong>@LinkedAccountsModel.ProviderName(identity.Provider)</strong>
                        @if (identity.DisplayName is not null)
                        {
                            <span>@identity.DisplayName</span>
                        }
                        @if (identity.LinkedAt is { } linkedAt)
                        {
                            <span class="muted">linked @linkedAt.UtcDateTime.ToString("dd MMM yyyy") UTC</span>
                        }
                        @if (Model.HasStrongPasskey)
                        {
                            <form method="post" asp-page-handler="UnlinkPasskey" class="inline-actions" data-passkey-unlink>
                                <input type="hidden" name="identityId" value="@identity.Id" />
                                <input type="hidden" name="id" />
                                <input type="hidden" name="rawId" />
                                <input type="hidden" name="authenticatorData" />
                                <input type="hidden" name="clientDataJson" />
                                <input type="hidden" name="signature" />
                                <input type="hidden" name="userHandle" />
                                <button class="button secondary" type="submit">Unlink with passkey</button>
                            </form>
                        }
                        else if (Model.HasGoogle)
                        {
                            <form method="post" asp-page-handler="Unlink" class="inline-actions">
                                <input type="hidden" name="identityId" value="@identity.Id" />
                                <button class="button secondary" type="submit">Unlink</button>
                            </form>
                        }
                    </li>
                }
            </ul>
            @if (Model.Identities.Count == 1)
            {
                <p class="muted">This is your only login. Heimdall will not remove the last one.</p>
            }

            @if (Model.HasStrongPasskey)
            {
                <p class="muted">Unlinking asks for one of your passkeys, then signs you in to Heimdall once more and removes only the login you picked.</p>
            }
            else if (Model.HasGoogle)
            {
                <p class="muted">Unlinking asks you to sign in with Google again as proof, then removes only the login you picked. A passkey, once it has cooled off, is stronger proof and takes over from Google.</p>
            }
            else
            {
                <p class="muted">
                    Unlinking needs strong proof, and none is available. Add a passkey below@(Model.NextStrongAt is { } waiting
                        ? $" (your newest one counts from {waiting.UtcDateTime:dd MMM yyyy HH:mm} UTC)"
                        : " (it counts after a 48 hour cooling-off)"),
                    or link a Google login once Heimdall has Google set up. Discord and Patreon cannot give that proof.
                </p>
            }

            <form method="post" asp-page-handler="Refresh" class="panel-actions">
                <button class="button secondary" type="submit">Read the list again</button>
            </form>
        }

        <h2>Passkeys</h2>
        @if (!Model.PasskeysAvailable)
        {
            <p class="muted">Passkeys are not available on this server right now.</p>
        }
        else
        {
            <p class="muted">
                A passkey is the strong proof for unlinking a login: it stays on your device, and a site that is not Bifrost cannot use it.
                A new passkey is added only right after you sign in to Heimdall again, and it counts as strong proof 48 hours later, so
                someone who borrows your open browser cannot add one and use it at once. You can revoke a passkey here at any time.
            </p>
            @if (Model.Passkeys.Count > 0)
            {
                <ul>
                    @foreach (var key in Model.Passkeys)
                    {
                        <li>
                            <strong>@key.Label</strong>
                            @if (key.IsStrong)
                            {
                                <span class="muted">active</span>
                            }
                            else
                            {
                                <span class="muted">cooling off until @key.StrongFromUtc.UtcDateTime.ToString("dd MMM yyyy HH:mm") UTC; cannot unlink yet</span>
                            }
                            <span class="muted">added @key.CreatedUtc.UtcDateTime.ToString("dd MMM yyyy") UTC</span>
                            @if (key.LastUsedUtc is { } used)
                            {
                                <span class="muted">last used @used.UtcDateTime.ToString("dd MMM yyyy") UTC</span>
                            }
                            <form method="post" asp-page-handler="PasskeyRevoke" class="inline-actions">
                                <input type="hidden" name="credentialId" value="@key.Id" />
                                <button class="button secondary" type="submit">Revoke</button>
                            </form>
                        </li>
                    }
                </ul>
            }

            @if (Model.PasskeyLimitReached)
            {
                <p class="muted">This is the most passkeys an account can hold. Revoke one to add another.</p>
            }
            else if (Model.CanEnrol)
            {
                <form method="post" asp-page-handler="PasskeyEnrol" id="passkey-enrol" data-passkey-enrol>
                    <input type="hidden" name="id" />
                    <input type="hidden" name="rawId" />
                    <input type="hidden" name="attestationObject" />
                    <input type="hidden" name="clientDataJson" />
                    <input type="hidden" name="transports" />
                    <label>Name for this passkey <input type="text" name="label" maxlength="40" value="Passkey" /></label>
                    <button class="button" type="submit">Add a passkey</button>
                </form>
                <noscript><p class="muted">Adding a passkey needs JavaScript.</p></noscript>
            }
            else if (Model.Identities is not null)
            {
                <form method="post" asp-page-handler="PasskeyEnrolStart" class="panel-actions">
                    <button class="button secondary" type="submit">Sign in again to add a passkey</button>
                </form>
            }
            else
            {
                <p class="muted">Read your linked logins first; adding a passkey then asks you to sign in to Heimdall once more.</p>
            }

            <p id="passkey-status" class="muted" role="status"></p>
        }

        @if (Model.Identities is not null)
        {
            <h2>Link another login</h2>
            <p class="muted">
                You will sign in to Heimdall again, then to the provider you pick. If that login already belongs to another account,
                nothing is linked and nothing is merged.
            </p>
            <div class="panel-actions">
                @foreach (var provider in Model.LinkableProviders)
                {
                    <form method="post" asp-page-handler="Link" class="inline-actions">
                        <input type="hidden" name="provider" value="@provider" />
                        <button class="button secondary" type="submit">Link @LinkedAccountsModel.ProviderName(provider)</button>
                    </form>
                }
            </div>
        }
    }

    <div class="panel-actions">
        <a class="button secondary" asp-page="/Membership/Status">Back to membership status</a>
    </div>
</section>

@section Scripts {
    @if (Model.HasHeimdallAccount && Model.PasskeysAvailable)
    {
        <script src="~/js/passkeys.js" asp-append-version="true"></script>
    }
}
