@page
@using Bifrost.Web.Domain
@model Bifrost.Web.Pages.App.Motions.IndexModel
@{
    ViewData["Title"] = "Motions";
}

<section class="panel-grid">
    <article class="panel">
        <span class="eyebrow">Governance</span>
        <h1>Open motions and voting</h1>
        <p class="panel-intro">
            Motions stay app-native here: no token theater, just explicit thresholds from the labor platform,
            weighted votes from current tier snapshots, and an auditable trail of who changed what.
        </p>

        <form method="post" asp-page-handler="Create">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Input.Scope"></label>
                    <select asp-for="Input.Scope" asp-items="Html.GetEnumSelectList<MotionScope>()"></select>
                    <span asp-validation-for="Input.Scope"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.ProjectId"></label>
                    <select asp-for="Input.ProjectId" asp-items="Model.ProjectOptions">
                        <option value="">No project scope</option>
                    </select>
                    <span asp-validation-for="Input.ProjectId"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Category"></label>
                    <select asp-for="Input.Category" asp-items="Html.GetEnumSelectList<MotionCategory>()"></select>
                    <span asp-validation-for="Input.Category"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.ClosesAtUtc"></label>
                    <input asp-for="Input.ClosesAtUtc" />
                    <span asp-validation-for="Input.ClosesAtUtc"></span>
                </div>
            </div>
            <div class="field">
                <label asp-for="Input.Title"></label>
                <input asp-for="Input.Title" />
                <span asp-validation-for="Input.Title"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Summary"></label>
                <textarea asp-for="Input.Summary"></textarea>
                <span asp-validation-for="Input.Summary"></span>
            </div>
            <div class="panel-actions">
                <button class="button" type="submit">Open motion</button>
            </div>
        </form>
    </article>

    <article class="panel">
        <div class="panel-header">
            <div>
                <h2>Vote ledger</h2>
                <p class="muted">Your current effective vote weight is @Model.Actor.EffectiveVotingWeight.ToString("0.##").</p>
            </div>
        </div>

        <div class="list-grid">
            <div class="status-banner">
                <strong>Bugs</strong>
                <span class="muted">15% threshold</span>
            </div>
            <div class="status-banner">
                <strong>Cosmetics</strong>
                <span class="muted">30% threshold</span>
            </div>
            <div class="status-banner">
                <strong>Balance changes</strong>
                <span class="muted">40% threshold</span>
            </div>
            <div class="status-banner">
                <strong>Features and new content</strong>
                <span class="muted">50% threshold</span>
            </div>
            <div class="status-banner">
                <strong>Fundamental design changes</strong>
                <span class="muted">66% threshold</span>
            </div>
        </div>
    </article>
</section>

<section class="panel" style="margin-top: 1.5rem;">
    @if (Model.Motions.Count == 0)
    {
        <div class="empty-state">No motions yet.</div>
    }
    else
    {
        <div class="motion-grid">
            @foreach (var motion in Model.Motions)
            {
                <article class="motion-card">
                    <div class="inline-actions">
                        <span class="pill">@motion.Scope</span>
                        <span class="pill">@motion.Category</span>
                        <span class="pill @motion.StatusTone">@motion.StatusLabel</span>
                    </div>
                    <h3>@motion.Title</h3>
                    <p class="muted">@motion.Summary</p>
                    <p class="muted">
                        @motion.ProjectName
                        · threshold @motion.Threshold.ToString("P0")
                        · closes @motion.ClosesAtUtc.ToString("dd MMM yyyy HH:mm") UTC
                    </p>
                    <div class="inline-actions">
                        <span class="pill success">For @motion.VotesFor</span>
                        <span class="pill danger">Against @motion.VotesAgainst</span>
                        <span class="pill">Abstain @motion.VotesAbstain</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(motion.ResolutionNote))
                    {
                        <p class="muted" style="margin-top: 0.8rem;">@motion.ResolutionNote</p>
                    }
                    <div class="vote-strip">
                        @foreach (var choice in Enum.GetValues<VoteChoice>())
                        {
                            <form method="post" asp-page-handler="Vote">
                                <input type="hidden" name="motionId" value="@motion.Id" />
                                <input type="hidden" name="choice" value="@choice" />
                                <input type="hidden" name="comment" value="" />
                                <button class="button @(motion.CurrentUserVote == choice ? "warm" : "secondary")" type="submit">
                                    Vote @choice
                                </button>
                            </form>
                        }

                        @if (Model.Actor.CanModerateMotions || motion.StatusLabel == "Expired")
                        {
                            <form method="post" asp-page-handler="Close">
                                <input type="hidden" name="motionId" value="@motion.Id" />
                                <button class="button ghost" type="submit">Close motion</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
