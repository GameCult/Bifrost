@page "/App"
@model Bifrost.Web.Pages.App.IndexModel
@{
    ViewData["Title"] = "Member console";
}

<section class="panel">
    <div class="panel-header">
        <div>
            <span class="eyebrow">Member console</span>
            <h1>Operational picture for @Model.Actor.DisplayName</h1>
            <p class="panel-intro">
                This is the alpha control room: personal lanes for your work, a shared operational picture,
                governance pressure, and recent team activity in one place.
            </p>
        </div>
        <button class="button secondary"
                hx-get="@Url.Page("/App/Index", "Summary")"
                hx-target="#summary-cards"
                hx-swap="outerHTML">
            Refresh snapshot
        </button>
    </div>

    <div id="summary-cards">
        <partial name="_SummaryCards" model="Model.Snapshot" />
    </div>
</section>

<section class="panel-grid" style="margin-top: 1.5rem;">
    <article class="panel">
        <div class="panel-header">
            <div>
                <h2>My assigned work</h2>
                <p class="muted">What is currently on your plate.</p>
            </div>
            <a class="button ghost" asp-page="/App/WorkItems/Index">Open work board</a>
        </div>

        @if (Model.Snapshot.MyAssignedWork.Count == 0)
        {
            <div class="empty-state">Nothing is currently assigned to you.</div>
        }
        else
        {
            <div class="list-grid">
                @foreach (var item in Model.Snapshot.MyAssignedWork)
                {
                    <div class="status-banner">
                        <strong>@item.Title</strong>
                        <span class="muted">@item.ProjectName</span>
                        <div class="inline-actions">
                            <span class="pill">@item.Status</span>
                            @if (item.TargetDateUtc is not null)
                            {
                                <span class="pill warning">Due @item.TargetDateUtc.Value.ToString("dd MMM")</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </article>

    <article class="panel">
        <div class="panel-header">
            <div>
                <h2>My submitted work</h2>
                <p class="muted">Items waiting on review or closure.</p>
            </div>
        </div>

        @if (Model.Snapshot.MySubmittedWork.Count == 0)
        {
            <div class="empty-state">Nothing of yours is waiting on review.</div>
        }
        else
        {
            <div class="list-grid">
                @foreach (var item in Model.Snapshot.MySubmittedWork)
                {
                    <div class="status-banner">
                        <strong>@item.Title</strong>
                        <span class="muted">@item.ProjectName</span>
                        <div class="inline-actions">
                            <span class="pill">@item.Status</span>
                        </div>
                    </div>
                }
            </div>
        }
    </article>
</section>

<section class="panel-grid" style="margin-top: 1.5rem;">
    <article class="panel">
        <div class="panel-header">
            <div>
                <h2>My volunteered work</h2>
                <p class="muted">Things you raised your hand for but are not fully assigned yet.</p>
            </div>
        </div>

        @if (Model.Snapshot.MyVolunteeredWork.Count == 0)
        {
            <div class="empty-state">No active volunteer claims right now.</div>
        }
        else
        {
            <div class="list-grid">
                @foreach (var item in Model.Snapshot.MyVolunteeredWork)
                {
                    <div class="status-banner">
                        <strong>@item.Title</strong>
                        <span class="muted">@item.ProjectName</span>
                        <div class="inline-actions">
                            <span class="pill">@item.Status</span>
                        </div>
                    </div>
                }
            </div>
        }
    </article>

    <article class="panel">
        <div class="panel-header">
            <div>
                <h2>Open motions</h2>
                <p class="muted">A quick read on governance traffic and threshold pressure.</p>
            </div>
            <a class="button ghost" asp-page="/App/Motions/Index">Review motions</a>
        </div>

        @if (Model.Snapshot.OpenMotionHighlights.Count == 0)
        {
            <div class="empty-state">No active motions yet.</div>
        }
        else
        {
            <div class="list-grid">
                @foreach (var motion in Model.Snapshot.OpenMotionHighlights)
                {
                    <div class="motion-card">
                        <h3>@motion.Title</h3>
                        <div class="inline-actions">
                            <span class="pill">@motion.Scope</span>
                            <span class="pill">@motion.Category</span>
                            <span class="pill success">For @motion.VotesFor</span>
                            <span class="pill danger">Against @motion.VotesAgainst</span>
                        </div>
                        <p class="muted">
                            Threshold @motion.Threshold.ToString("P0")
                            · closes @motion.ClosesAtUtc.ToString("dd MMM yyyy HH:mm") UTC
                        </p>
                    </div>
                }
            </div>
        }
    </article>
</section>

<section class="panel-grid" style="margin-top: 1.5rem;">
    <article class="panel">
        <div class="panel-header">
            <div>
                <h2>Recent work</h2>
                <p class="muted">Latest movement across the shared work board.</p>
            </div>
        </div>

        @if (Model.Snapshot.RecentWorkItems.Count == 0)
        {
            <div class="empty-state">No work items exist yet.</div>
        }
        else
        {
            <div class="list-grid">
                @foreach (var item in Model.Snapshot.RecentWorkItems)
                {
                    <div class="status-banner">
                        <strong>@item.Title</strong>
                        <span class="muted">@item.ProjectName</span>
                        <div class="inline-actions">
                            <span class="pill">@item.Status</span>
                            <span class="pill">@item.AssigneeName</span>
                            <span class="pill">@item.ActualHours.ToString("0.##") / @item.EstimatedHours.ToString("0.##")h</span>
                        </div>
                    </div>
                }
            </div>
        }
    </article>

    <article class="panel">
        <div class="panel-header">
            <div>
                <h2>Agent runs</h2>
                <p class="muted">Recent dispatched Codex runs recorded by Bifrost.</p>
            </div>
        </div>

        @if (Model.Snapshot.RecentDispatchRuns.Count == 0)
        {
            <div class="empty-state">No dispatched agent runs have been recorded yet.</div>
        }
        else
        {
            <div class="list-grid">
                @foreach (var run in Model.Snapshot.RecentDispatchRuns)
                {
                    <div class="status-banner">
                        <strong>@run.TargetRepoName@if (!string.IsNullOrWhiteSpace(run.TargetAgentIdentity)) {<text> / @run.TargetAgentIdentity</text>}</strong>
                        <span class="muted">@run.LaunchMode dispatch</span>
                        <div class="inline-actions">
                            <span class="pill">@run.Status</span>
                            <span class="pill">@run.RequestId</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(run.ThreadId) || !string.IsNullOrWhiteSpace(run.TurnId))
                        {
                            <div class="muted">Thread @run.ThreadId Turn @run.TurnId</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(run.Note))
                        {
                            <div class="muted">@run.Note</div>
                        }
                        <div class="muted">@run.UpdatedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</div>
                    </div>
                }
            </div>
        }
    </article>
</section>

<section class="panel-grid" style="margin-top: 1.5rem;">
    <article class="panel">
        <div class="panel-header">
            <div>
                <h2>Bridge receipts</h2>
                <p class="muted">Recent agent and service crossings recorded by Bifrost.</p>
            </div>
        </div>

        @if (Model.Snapshot.RecentBridgeActions.Count == 0)
        {
            <div class="empty-state">No bridge actions have been recorded yet.</div>
        }
        else
        {
            <div class="list-grid">
                @foreach (var action in Model.Snapshot.RecentBridgeActions)
                {
                    <div class="status-banner">
                        <strong>@action.ActorName</strong>
                        <span class="muted">@action.ActionKind on @action.TargetSurface</span>
                        <div class="inline-actions">
                            <span class="pill">@action.Status</span>
                            @if (!string.IsNullOrWhiteSpace(action.TargetRepositoryFullName))
                            {
                                <span class="pill">@action.TargetRepositoryFullName</span>
                            }
                        </div>
                        <div class="muted">@action.Title</div>
                        @if (!string.IsNullOrWhiteSpace(action.ReceiptLabel))
                        {
                            <div class="muted">@action.ReceiptLabel</div>
                        }
                        <div class="muted">@action.UpdatedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</div>
                    </div>
                }
            </div>
        }
    </article>
</section>

<section class="panel-grid" style="margin-top: 1.5rem;">
    <article class="panel">
        <div class="panel-header">
            <div>
                <h2>Recent activity</h2>
                <p class="muted">Audit trail excerpts across membership, work, motions, and ledger changes.</p>
            </div>
        </div>

        @if (Model.Snapshot.RecentActivity.Count == 0)
        {
            <div class="empty-state">No team activity yet.</div>
        }
        else
        {
            <div class="list-grid">
                @foreach (var activity in Model.Snapshot.RecentActivity)
                {
                    <div class="status-banner">
                        <strong>@activity.ActorName</strong>
                        <span class="muted">@activity.Action</span>
                        <div class="muted">@activity.Detail</div>
                        <div class="muted">@activity.OccurredAtUtc.ToString("dd MMM yyyy HH:mm") UTC</div>
                    </div>
                }
            </div>
        }
    </article>
</section>
