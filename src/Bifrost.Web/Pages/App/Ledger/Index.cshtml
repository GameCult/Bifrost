@page
@model Bifrost.Web.Pages.App.Ledger.IndexModel
@{
    ViewData["Title"] = "Ledger";
}

<section class="panel-grid">
    <article class="panel">
        <span class="eyebrow">Ledger</span>
        <h1>Contribution and payout accounting</h1>
        <p class="panel-intro">
            The app does not pay anyone directly in v1. It records the accounting facts that make
            payout review possible later, with explicit status and enough context to audit the trail.
        </p>

        <div class="callout">
            Patron support events now feed derived tier snapshots for voting weight. Broader economics automation still leaves room for point transactions,
            weekly decay runs, revenue events, and revenue-share batches without making them launch blockers.
        </div>

        @if (Model.Actor.CanManageLedger)
        {
            <form method="post" asp-page-handler="Create">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="Input.UserAccountId"></label>
                        <select asp-for="Input.UserAccountId" asp-items="Model.MemberOptions"></select>
                        <span asp-validation-for="Input.UserAccountId"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.EntryType"></label>
                        <select asp-for="Input.EntryType" asp-items="Html.GetEnumSelectList<LedgerEntryType>()"></select>
                        <span asp-validation-for="Input.EntryType"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Status"></label>
                        <select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<LedgerEntryStatus>()"></select>
                        <span asp-validation-for="Input.Status"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.ProjectId"></label>
                        <select asp-for="Input.ProjectId" asp-items="Model.ProjectOptions">
                            <option value="">No project</option>
                        </select>
                        <span asp-validation-for="Input.ProjectId"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.WorkItemId"></label>
                        <select asp-for="Input.WorkItemId" asp-items="Model.WorkItemOptions">
                            <option value="">No work item</option>
                        </select>
                        <span asp-validation-for="Input.WorkItemId"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.Points"></label>
                        <input asp-for="Input.Points" />
                        <span asp-validation-for="Input.Points"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Input.NominalAmount"></label>
                        <input asp-for="Input.NominalAmount" />
                        <span asp-validation-for="Input.NominalAmount"></span>
                    </div>
                </div>
                <div class="field">
                    <label asp-for="Input.Note"></label>
                    <textarea asp-for="Input.Note"></textarea>
                    <span asp-validation-for="Input.Note"></span>
                </div>
                <div class="panel-actions">
                    <button class="button" type="submit">Record entry</button>
                </div>
            </form>
        }
        else
        {
            <div class="callout warning">
                Ledger review actions are limited to finance reviewers and platform admins, but the ledger remains visible to all active members.
            </div>
        }
    </article>

    <article class="panel">
        <span class="eyebrow">Patronage</span>
        <h2>Support events</h2>
        <p class="panel-intro">
            Patron voting power is derived from support events and tier snapshots. Reddit and Discord can organize the argument;
            this ledger records the support state that decides weight.
        </p>

        @if (Model.Actor.CanManageLedger)
        {
            <form method="post" asp-page-handler="RecordPatronSupport">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="PatronSupport.UserAccountId"></label>
                        <select asp-for="PatronSupport.UserAccountId" asp-items="Model.MemberOptions"></select>
                        <span asp-validation-for="PatronSupport.UserAccountId"></span>
                    </div>
                    <div class="field">
                        <label asp-for="PatronSupport.Kind"></label>
                        <select asp-for="PatronSupport.Kind" asp-items="Html.GetEnumSelectList<Bifrost.Web.Domain.PatronSupportEventKind>()"></select>
                        <span asp-validation-for="PatronSupport.Kind"></span>
                    </div>
                    <div class="field">
                        <label asp-for="PatronSupport.Amount"></label>
                        <input asp-for="PatronSupport.Amount" />
                        <span asp-validation-for="PatronSupport.Amount"></span>
                    </div>
                    <div class="field">
                        <label asp-for="PatronSupport.CurrencyCode"></label>
                        <input asp-for="PatronSupport.CurrencyCode" />
                        <span asp-validation-for="PatronSupport.CurrencyCode"></span>
                    </div>
                    <div class="field">
                        <label asp-for="PatronSupport.ExternalSupportId"></label>
                        <input asp-for="PatronSupport.ExternalSupportId" />
                        <span asp-validation-for="PatronSupport.ExternalSupportId"></span>
                    </div>
                    <div class="field">
                        <label asp-for="PatronSupport.SupportedAtUtc"></label>
                        <input asp-for="PatronSupport.SupportedAtUtc" />
                        <span asp-validation-for="PatronSupport.SupportedAtUtc"></span>
                    </div>
                </div>
                <label class="check-row">
                    <input asp-for="PatronSupport.IsCurrentRecurringSupport" />
                    <span>Mark as the current recurring support snapshot</span>
                </label>
                <div class="field">
                    <label asp-for="PatronSupport.Notes"></label>
                    <textarea asp-for="PatronSupport.Notes"></textarea>
                    <span asp-validation-for="PatronSupport.Notes"></span>
                </div>
                <div class="panel-actions">
                    <button class="button" type="submit">Record patron support</button>
                </div>
            </form>
        }
        else
        {
            <div class="callout warning">
                Patron support recording is limited to finance reviewers and platform admins.
            </div>
        }
    </article>

    <article class="panel">
        <div class="panel-header">
            <div>
                <h2>Payout proposal preview</h2>
                <p class="muted">Approved nominal values grouped by member.</p>
            </div>
        </div>

        @if (Model.PayoutPreview.Count == 0)
        {
            <div class="empty-state">No approved ledger entries yet.</div>
        }
        else
        {
            <div class="preview-grid">
                @foreach (var preview in Model.PayoutPreview)
                {
                    <article class="preview-card">
                        <h3>@preview.MemberName</h3>
                        <span class="pill">@preview.Points.ToString("0.##") pts</span>
                        <p class="muted">Nominal value @preview.NominalAmount.ToString("0.##")</p>
                    </article>
                }
            </div>
        }
    </article>
</section>

<section class="table-panel" style="margin-top: 1.5rem;">
    <div class="panel-header" style="padding: 1.25rem 1.25rem 0;">
        <div>
            <h2>Recent patron support</h2>
            <p class="table-meta">@Model.PatronSupportEvents.Count support events in the current view.</p>
        </div>
    </div>

    @if (Model.PatronSupportEvents.Count == 0)
    {
        <div class="empty-state" style="margin: 1.25rem;">No patron support recorded yet.</div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Support</th>
                        <th>Derived patron state</th>
                        <th>Receipt</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var support in Model.PatronSupportEvents)
                    {
                        <tr>
                            <td>@support.MemberName</td>
                            <td>
                                <span class="pill">@support.Provider</span>
                                <span class="pill">@support.Kind</span><br />
                                @support.Amount.ToString("0.##") @support.CurrencyCode
                                @if (support.IsCurrentRecurringSupport)
                                {
                                    <div><span class="pill success">current recurring</span></div>
                                }
                            </td>
                            <td>
                                @support.EffectivePoints.ToString("0.##") effective pts<br />
                                <span class="muted">
                                    @(string.IsNullOrWhiteSpace(support.TierLabel)
                                        ? "No patron tier"
                                        : $"{support.TierLabel} weight {support.VotingWeight:0.##}")
                                </span>
                            </td>
                            <td>
                                <span class="muted">@support.ExternalSupportId</span><br />
                                <span class="muted">@support.SupportedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</span>
                            </td>
                            <td>
                                @if (Model.Actor.CanManageLedger)
                                {
                                    <form method="post" asp-page-handler="RefreshPatronTier">
                                        <input type="hidden" name="userAccountId" value="@support.UserAccountId" />
                                        <button class="button ghost" type="submit">Refresh tier</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="table-panel" style="margin-top: 1.5rem;">
    <div class="panel-header" style="padding: 1.25rem 1.25rem 0;">
        <div>
            <h2>Recent ledger events</h2>
            <p class="table-meta">@Model.LedgerEntries.Count entries in the current view.</p>
        </div>
    </div>

    @if (Model.LedgerEntries.Count == 0)
    {
        <div class="empty-state" style="margin: 1.25rem;">No ledger activity yet.</div>
    }
    else
    {
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Type</th>
                        <th>Value</th>
                        <th>Status</th>
                        <th>Context</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.LedgerEntries)
                    {
                        <tr>
                            <td>@entry.UserAccount.DisplayName</td>
                            <td>
                                <span class="pill">@entry.EntryType</span>
                            </td>
                            <td>
                                @entry.Points.ToString("0.##") pts<br />
                                <span class="muted">@entry.NominalAmount.ToString("0.##") nominal</span>
                            </td>
                            <td><span class="pill">@entry.Status</span></td>
                            <td>
                                @entry.Project?.Name
                                @if (entry.WorkItem is not null)
                                {
                                    <div class="muted">@entry.WorkItem.Title</div>
                                }
                                <div class="muted">@entry.Note</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
